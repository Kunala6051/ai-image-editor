# Copy this file to .env and fill in what you have.
# Never put real keys in .env.example, only in .env (which is git-ignored).

# Provider options: hfspace (free) | huggingface | gemini | openai | mock
PROVIDER=hfspace

# Free Hugging Face token: huggingface.co/settings/tokens
HF_TOKEN=

# Public Space used by the hfspace provider
HF_SPACE=black-forest-labs/FLUX.1-Kontext-Dev

# Optional and free: enables the prompt-planning step and captions
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Only needed for the paid providers
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini

# Used only by PROVIDER=huggingface (Inference Providers)
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-Kontext-dev
HF_PROVIDER=auto

DATA_DIR=data